}

class "public.user_dietary_restrictions" as user_dietary_restrictions <<tabla>> {
  user_id : UUID <<PK, FK public.profiles.id>>
  restriction_id : UUID <<PK, FK public.dietary_restrictions.id>>
  created_at : TIMESTAMPTZ
}

class "public.nutrition_goals" as nutrition_goals <<tabla>> {
