}

class "public.meal_base_categories" as meal_base_categories <<tabla>> {
  id : UUID <<PK>>
  name : TEXT
  created_at : TIMESTAMPTZ
}

class "public.assets" as assets <<tabla>> {
  id : UUID <<PK>>
  restaurant_id : UUID <<FK public.restaurants.id>>
  bucket_id : TEXT
  path : TEXT
  title : TEXT
  content_type : TEXT
