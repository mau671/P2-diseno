}

class "public.meal_bases" as meal_bases <<tabla>> {
  id : UUID <<PK>>
  restaurant_id : UUID <<FK public.restaurants.id>>
  name : TEXT
  description : TEXT
  image_asset_id : UUID <<FK public.assets.id>>
  base_price : NUMERIC(10,2)
  is_active : BOOLEAN
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

class "public.meal_base_category_map" as meal_base_category_map <<tabla>> {
