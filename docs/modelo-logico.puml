@startuml
left to right direction
hide circle
skinparam linetype ortho
skinparam classAttributeIconSize 0

' Modelo logico en notacion de clases

class "auth.users" as auth_users <<tabla>> {
  id : UUID <<PK>>
  email : TEXT
}

class "public.profiles" as profiles <<tabla>> {
  id : UUID <<PK, FK auth.users.id>>
  full_name : TEXT
  phone : TEXT
  avatar_url : TEXT
  date_of_birth : DATE
  preferred_language : TEXT
  notification_preferences : JSONB
  preferred_currency_code : TEXT
  is_admin : BOOLEAN
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

class "public.restaurants" as restaurants <<tabla>> {
  id : UUID <<PK>>
  name : TEXT
  legal_name : TEXT
  status : TEXT
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

class "public.currencies" as currencies <<tabla>> {
  code : TEXT <<PK>>
  name : TEXT
  symbol : TEXT
  precision : INTEGER
  is_active : BOOLEAN
  created_at : TIMESTAMPTZ
}

class "public.restaurant_currencies" as restaurant_currencies <<tabla>> {
  restaurant_id : UUID <<PK, FK public.restaurants.id>>
  currency_code : TEXT <<PK, FK public.currencies.code>>
  is_default : BOOLEAN
  created_at : TIMESTAMPTZ
}

class "public.countries" as countries <<tabla>> {
  id : UUID <<PK>>
  iso2 : TEXT
  iso3 : TEXT
  name_es : TEXT
  name_en : TEXT
  created_at : TIMESTAMPTZ
}

class "public.regions" as regions <<tabla>> {
  id : UUID <<PK>>
  country_id : UUID <<FK public.countries.id>>
  name : TEXT
  created_at : TIMESTAMPTZ
}

class "public.cities" as cities <<tabla>> {
  id : UUID <<PK>>
  region_id : UUID <<FK public.regions.id>>
  name : TEXT
  created_at : TIMESTAMPTZ
}

class "public.addresses" as addresses <<tabla>> {
  id : UUID <<PK>>
  line1 : TEXT
  line2 : TEXT
  city_id : UUID <<FK public.cities.id>>
  region_id : UUID <<FK public.regions.id>>
  country_id : UUID <<FK public.countries.id>>
  postal_code : TEXT
  notes : TEXT
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

class "public.kitchens" as kitchens <<tabla>> {
  id : UUID <<PK>>
  restaurant_id : UUID <<FK public.restaurants.id>>
  name : TEXT
  address_id : UUID <<FK public.addresses.id>>
  status : TEXT
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

class "public.restaurant_users" as restaurant_users <<tabla>> {
  restaurant_id : UUID <<PK, FK public.restaurants.id>>
  user_id : UUID <<PK, FK public.profiles.id>>
  role : TEXT
  created_at : TIMESTAMPTZ
}

class "public.dietary_restriction_types" as dietary_restriction_types <<tabla>> {
  id : UUID <<PK>>
  name : TEXT
  created_at : TIMESTAMPTZ
}

class "public.dietary_restrictions" as dietary_restrictions <<tabla>> {
  id : UUID <<PK>>
  name : TEXT
  restriction_type_id : UUID <<FK public.dietary_restriction_types.id>>
