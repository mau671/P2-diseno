}

class "public.ingredients" as ingredients <<tabla>> {
  id : UUID <<PK>>
  restaurant_id : UUID <<FK public.restaurants.id>>
  category_id : UUID <<FK public.ingredient_categories.id>>
  name : TEXT
  unit_price : NUMERIC(10,2)
  stock : INTEGER
  is_active : BOOLEAN
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

class "public.ingredient_restrictions" as ingredient_restrictions <<tabla>> {
  ingredient_id : UUID <<PK, FK public.ingredients.id>>
