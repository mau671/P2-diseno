class "public.orders" as orders <<tabla>> {
  id : UUID <<PK>>
  user_id : UUID <<FK public.profiles.id>>
  restaurant_id : UUID <<FK public.restaurants.id>>
  kitchen_id : UUID <<FK public.kitchens.id>>
  delivery_address_id : UUID <<FK public.addresses.id>>
  status : TEXT
  currency_code : TEXT <<FK public.currencies.code>>
  exchange_rate : NUMERIC(12,6)
  payment_method : TEXT
  payment_method_id : UUID <<FK public.payment_methods.id>>
  scheduled_for : TIMESTAMPTZ
  subtotal : NUMERIC(10,2)
  tax : NUMERIC(10,2)
  total : NUMERIC(10,2)
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

class "public.order_items" as order_items <<tabla>> {
  id : UUID <<PK>>
